# ══════════════════════════════════════════════════════════════════════════════
# Sewa Setu — Production Caddy Gateway
#
# Deployment: Cloudflare (proxy) → AWS EC2 (this Caddy) → containers
#
# Cloudflare SSL mode MUST be "Full" or "Full (Strict)" — NOT "Flexible".
# With Flexible, Cloudflare sends plain HTTP to this server, but all JWT `iss`
# values say https://... and the JWKS/discovery URLs say https://... which
# confuses AI clients that cross-check the issuer URL.
#
# Because Cloudflare terminates TLS, Caddy only listens on :80.
# We disable Caddy's own auto-HTTPS (it can't issue certs behind Cloudflare).
#
# RFC 9728 §3.1 — how the MCP framework builds the metadata URL:
#   resource_server_url = https://sewasetu.sercho.in/mcp/citizen
#   metadata URL        = https://host/.well-known/oauth-protected-resource<path>
#                       = https://sewasetu.sercho.in/.well-known/oauth-protected-resource/mcp/citizen
#
# The MCP SDK registers that FULL PATH inside the container.
# So we must forward /.well-known/oauth-protected-resource/mcp/citizen
# to the container WITHOUT stripping any prefix.
#
# For regular MCP traffic (/mcp/citizen → container root /),
# we still strip /mcp/citizen as before.
# ══════════════════════════════════════════════════════════════════════════════

{
    auto_https off
}

:80 {

    # ── Security headers (applied to every response) ──────────────────────── #
    header {
        # Tell browsers this must be HTTPS (Cloudflare enforces this too, but belt-and-braces)
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Basic clickjacking protection for the portal login/consent pages
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Don't expose Caddy version
        -Server
    }

    # ── Real-IP forwarding for Flask / rate limiting ──────────────────────── #
    # Cloudflare puts the real client IP in CF-Connecting-IP.
    # Flask reads REMOTE_ADDR; tell Caddy to overwrite it with the real IP.
    # (Caddy trusts Cloudflare's IP ranges automatically via X-Forwarded-For.)

    # ── RFC 9728 Protected Resource Metadata ─────────────────────────────── #
    # These paths MUST be forwarded with the FULL path intact (no stripping).
    # The MCP container registered the route at the full path.
    #
    #   GET /.well-known/oauth-protected-resource/mcp/citizen
    #       → citizen_mcp:8001  (container serves metadata JSON at this full path)
    #
    #   GET /.well-known/oauth-protected-resource/mcp/officer
    #       → officer_mcp:8002
    #
    handle /.well-known/oauth-protected-resource/mcp/citizen* {
        reverse_proxy citizen_mcp:8001 {
            flush_interval -1
        }
    }

    handle /.well-known/oauth-protected-resource/mcp/officer* {
        reverse_proxy officer_mcp:8002 {
            flush_interval -1
        }
    }

    # ── Citizen MCP wire protocol ─────────────────────────────────────────── #
    # /mcp/citizen → strip prefix → container sees /  (streamable_http_path="/")
    handle_path /mcp/citizen* {
        reverse_proxy citizen_mcp:8001 {
            flush_interval -1
            # Pass the real protocol so the MCP container can log correct URLs
            header_up X-Forwarded-Proto "https"
        }
    }

    # ── Officer MCP wire protocol ─────────────────────────────────────────── #
    handle_path /mcp/officer* {
        reverse_proxy officer_mcp:8002 {
            flush_interval -1
            header_up X-Forwarded-Proto "https"
        }
    }

    # ── Flask portal + OAuth 2.1 authorization server + eval dashboard ──────  #
    handle {
        reverse_proxy app:8000 {
            # Flask needs to know the real scheme to build correct redirect URIs
            # and to stamp the correct `iss` in tokens.
            header_up X-Forwarded-Proto "https"
            header_up X-Forwarded-Host {host}
        }
    }
}
