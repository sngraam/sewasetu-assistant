# ──────────────────────────────────────────────────────────────────────────────
# Sewa Setu MCP servers — environment variables
# Copy to .env and fill in your values before running outside docker-compose.
# docker-compose.yml sets all of these automatically; you only need this file
# for running the MCP servers directly (e.g. python citizen_mcp.py).
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (same PostgreSQL instance as the portal) ─────────────────────── #
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sewasetu
DB_USER=sewasetu
DB_PASSWORD=sewasetu123

# ── SMS gateway ───────────────────────────────────────────────────────────── #
SMS_GATEWAY_URL=http://localhost:8025
OTP_VALIDITY_SECONDS=300

# ── JWT / OAuth 2.1 audience ──────────────────────────────────────────────── #
#
# PORTAL_ISSUER   : canonical PUBLIC URL of the portal (= PUBLIC_BASE_URL in app).
#                   This value is stamped as `iss` in every JWT the portal signs.
#                   It MUST match exactly (including http vs https, trailing slash).
#
# PORTAL_JWKS_URL : where the MCP server fetches the portal's public signing keys.
#                   Inside docker-compose, use the internal container name:
#                       http://app:8000/.well-known/jwks.json
#                   Running outside docker, use the public URL:
#                       http://localhost:8000/.well-known/jwks.json
#
# CITIZEN_MCP_URL : canonical PUBLIC URL of the citizen MCP endpoint.
#                   This is used as the JWT `aud` (audience) for citizen tokens.
#                   MUST match the URL the AI client connects to.
#                   Example (Caddy): https://sewasetu.example.in/mcp/citizen/mcp
#
# OFFICER_MCP_URL : canonical PUBLIC URL of the officer MCP endpoint.
#                   Used as `aud` for officer tokens.
#
PORTAL_ISSUER=http://localhost:8000
PORTAL_JWKS_URL=http://localhost:8000/.well-known/jwks.json
CITIZEN_MCP_URL=http://localhost:8000/mcp/citizen/mcp
OFFICER_MCP_URL=http://localhost:8000/mcp/officer/mcp

# ── Scheme configuration ──────────────────────────────────────────────────── #
MIN_AGE=60
SLA_DAYS=15
SCHEME_DEADLINE=2026-10-31 23:59

# Comma-separated list of blocks served by the AI channel (pilot scope).
# Citizens in other blocks must apply at the counter or the web portal.
AGENT_BLOCKS=Sonari,Rajapara,Dhemaji Pathar

# ── Dev bypass — skip JWT verification for local testing ──────────────────── #
# WARNING: NEVER set these on the public deployment.
# Uncomment ONE of the lines below to bypass auth for that server.
#
# DEV_INSECURE_MOBILE=9876543210    # citizen_mcp: act as this mobile number
# DEV_INSECURE_OFFICER=admin        # officer_mcp: act as this officer username

# ── Logging ───────────────────────────────────────────────────────────────── #
# LOG_FORMAT=json    # "json" (production) or "text" (development)
# LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR

# ── Service version (shown in health checks) ──────────────────────────────── #
# SERVICE_VERSION=1.0.0
